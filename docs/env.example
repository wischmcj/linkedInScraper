# LinkedIn Scraper Environment Variables
# Copy this file to .env and fill in your credentials

# Your LinkedIn email address
LINKEDIN_USERNAME=your_email@example.com

# Your LinkedIn password
LINKEDIN_PASSWORD=your_password

# Optional: Add delays between requests (in milliseconds)
# REQUEST_DELAY=1000

# Optional: Maximum number of jobs to fetch per company (default: unlimited)
# MAX_JOBS_PER_COMPANY=50

# Optional: Enable detailed logging
# DEBUG=true
